# Run E2E tests with Spanner emulator
test-e2e:
	@echo "Starting Spanner emulator..."
	@docker-compose up -d spanner-emulator
	@sleep 2
	@echo "Running E2E tests..."
	@SPANNER_EMULATOR_HOST=localhost:9010 go test -v -coverprofile=e2e_coverage.out ./test/e2e/...
	@echo "Stopping Spanner emulator..."
	@docker-compose down

# Run E2E tests with coverage report
test-e2e-coverage:
	@echo "Starting Spanner emulator..."
	@docker-compose up -d spanner-emulator
	@sleep 2
	@echo "Running E2E tests with coverage..."
	@SPANNER_EMULATOR_HOST=localhost:9010 go test -v -coverprofile=e2e_coverage.out ./test/e2e/...
	@go tool cover -html=e2e_coverage.out -o e2e_coverage.html
	@echo "Coverage report generated: e2e_coverage.html"
	@docker-compose down

# Run specific E2E test
test-e2e-single:
	@echo "Starting Spanner emulator..."
	@docker-compose up -d spanner-emulator
	@sleep 2
	@echo "Running test: $(TEST)"
	@SPANNER_EMULATOR_HOST=localhost:9010 go test -v ./test/e2e -run $(TEST)
	@docker-compose down

# Run all tests (unit + E2E)
test-all:
	@echo "Running unit tests..."
	@go test -v ./internal/...
	@echo "\nRunning E2E tests..."
	@docker-compose up -d spanner-emulator
	@sleep 2
	@SPANNER_EMULATOR_HOST=localhost:9010 go test -v ./test/e2e/...
	@docker-compose down

.PHONY: test-e2e test-e2e-coverage test-e2e-single test-all
